# Demo convenience only: copy to .env, or export these in your shell.
OPENAI_MODEL=gpt-4.1
OPENAI_BASE_URL=https://your-provider.example/v1
OPENAI_API_KEY=replace-with-your-key

# Optional independent operator configuration; defaults to OPENAI_* above.
# VERIFY_MODEL=gpt-4.1
# VERIFY_BASE_URL=https://your-provider.example/v1
# VERIFY_API_KEY=replace-with-your-key

